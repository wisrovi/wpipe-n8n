{
  "format": "wpipe",
  "project": {
    "id": "pipeline",
    "name": "main_pipeline",
    "protocol": "fastapi",
    "docker_image": "",
    "canvas_ir": {
      "nodes": [
        {
          "id": "node_1",
          "type": "default",
          "position": {
            "x": 80,
            "y": 50
          },
          "data": {
            "label": "Trigger (API: /run)",
            "node_type": "trigger",
            "trigger_type": "api",
            "trigger_param": "/run",
            "origin": "described",
            "params": {
              "trigger_type": "api",
              "trigger_param": "/run"
            },
            "contract": {
              "reads": [
                "data"
              ],
              "writes": [
                "result"
              ],
              "inferred": "exact"
            },
            "merge_policy": "accumulate",
            "block_type": "wpipe_trigger"
          }
        },
        {
          "id": "node_2",
          "type": "default",
          "position": {
            "x": 80,
            "y": 150
          },
          "data": {
            "label": "Response (HTTP_JSON: {\"status\": \"success\", \"data\": context})",
            "node_type": "response",
            "response_type": "http_json",
            "response_param": "{\"status\": \"success\", \"data\": context}",
            "origin": "described",
            "params": {
              "response_type": "http_json",
              "response_param": "{\"status\": \"success\", \"data\": context}"
            },
            "contract": {
              "reads": [
                "data"
              ],
              "writes": [
                "result"
              ],
              "inferred": "exact"
            },
            "merge_policy": "accumulate",
            "block_type": "wpipe_response"
          }
        }
      ],
      "edges": [
        {
          "id": "e_seq_node_1_node_2",
          "source": "node_1",
          "target": "node_2"
        }
      ],
      "workspace_state": {
        "blocks": {
          "languageVersion": 0,
          "blocks": [
