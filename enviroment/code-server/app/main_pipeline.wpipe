              "id": "root_trigger",
              "x": 80,
              "y": 50,
              "fields": {
                "TRIGGER_TYPE": "api",
                "TRIGGER_PARAM": "/run"
              },
              "next": {
                "block": {
                  "type": "wpipe_response",
                  "id": "root_response",
